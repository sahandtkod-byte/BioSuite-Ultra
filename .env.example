# BioSuite Ultra — example environment configuration.
# Copy to .env and fill in real values. NEVER commit the filled-in .env.
#
# The API refuses to start in production unless all three secrets below are
# set to non-placeholder values. Generate strong random values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Shared API key required by every /api/* request (X-API-Key header).
BIOSUITE_API_KEY=

# Signing secret for admin JWTs. Rotating this invalidates all issued tokens.
BIOSUITE_JWT_SECRET=

# Admin password. If unset, admin login is DISABLED (there is no default).
BIOSUITE_ADMIN_PASSWORD=

# Comma-separated list of allowed CORS origins. No wildcard is accepted while
# credentials are enabled. Example:
#   BIOSUITE_CORS_ORIGINS=https://app.example.com,https://admin.example.com
BIOSUITE_CORS_ORIGINS=

# Directory the file endpoints are confined to. Paths outside it are rejected.
BIOSUITE_DATA_DIR=

# Development conveniences. Set to 1 ONLY on a workstation: it allows startup
# without configured secrets and exposes /docs, /redoc and /openapi.json.
# BIOSUITE_DEV_MODE=0

# Console log level. BIOSUITE_DEBUG=1 is shorthand for DEBUG.
# BIOSUITE_LOG_LEVEL=INFO
